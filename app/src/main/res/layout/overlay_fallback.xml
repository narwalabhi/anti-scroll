<?xml version="1.0" encoding="utf-8"?>
<!-- The fallback watcher's cover over Instagram while the accessibility service is off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="28dp">

    <include layout="@layout/overlay_brand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_round_icon"
            android:importantForAccessibility="no"
            android:padding="24dp"
            android:src="@drawable/ic_warning"
            android:tint="@color/coral" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/fallback_title"
            android:textAppearance="@style/TextAppearance.AS.OverlayTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="@string/fallback_message"
            android:textAppearance="@style/TextAppearance.AS.Lead" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fallbackTurnOn"
        style="@style/AS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/turn_accessibility_on" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fallbackClose"
        style="@style/AS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/close_instagram" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fallbackUncounted"
        style="@style/AS.Button.Text.Quiet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/fallback_uncounted" />
</LinearLayout>
