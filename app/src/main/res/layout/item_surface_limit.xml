<?xml version="1.0" encoding="utf-8"?>
<!-- One surface's limit on the hero card: name, "39m of 30m", a small gauge, over or left. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        style="@style/AS.Divider"
        android:layout_marginVertical="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/surfaceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.AS.CardTitle"
            tools:text="Reels" />

        <TextView
            android:id="@+id/surfaceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AS.BodySecondary"
            tools:text="39m of 30m" />
    </LinearLayout>

    <com.abhishek.antiscroll.ui.widget.GaugeView
        android:id="@+id/surfaceGauge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/surfaceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_semibold"
        android:textSize="13sp"
        tools:text="9 min over" />
</LinearLayout>
