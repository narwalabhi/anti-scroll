<?xml version="1.0" encoding="utf-8"?>
<!-- Three tabs (docs/UI.md, Navigation): each screen is inflated once and shown or hidden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/screens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/today"
            layout="@layout/screen_today" />

        <include
            android:id="@+id/limits"
            layout="@layout/screen_limits"
            android:visibility="gone" />

        <include
            android:id="@+id/settings"
            layout="@layout/screen_settings"
            android:visibility="gone" />
    </FrameLayout>

    <View style="@style/AS.Divider" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:minHeight="84dp"
        app:itemIconTint="@color/nav_item"
        app:itemTextAppearanceActive="@style/TextAppearance.AS.NavActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.AS.Nav"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_nav" />
</LinearLayout>
