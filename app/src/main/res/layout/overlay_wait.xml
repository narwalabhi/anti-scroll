<?xml version="1.0" encoding="utf-8"?>
<!-- First part of an override: a wait. Also used by the settings challenge (LoosenActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="28dp">

    <include layout="@layout/overlay_override_chip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="216dp"
            android:layout_height="216dp">

            <com.abhishek.antiscroll.ui.widget.RingView
                android:id="@+id/waitRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/waitTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/waitTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AS.Display"
                    tools:text="0:42" />

                <TextView
                    android:id="@+id/waitOf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.AS.BodySecondary"
                    tools:text="of 1:00" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/waitHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="@string/wait_title"
            android:textAppearance="@style/TextAppearance.AS.Headline" />

        <TextView
            android:id="@+id/waitSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:text="@string/wait_subtitle"
            android:textAppearance="@style/TextAppearance.AS.BodySecondary"
            android:textSize="15sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/waitCancel"
        style="@style/AS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wait_never_mind" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/waitContinue"
        style="@style/AS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:enabled="false"
        android:minHeight="60dp"
        tools:text="Continue · 0:42" />
</LinearLayout>
