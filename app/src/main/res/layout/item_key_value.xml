<?xml version="1.0" encoding="utf-8"?>
<!-- A label and its value on one line; three columns for the ladder table. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/kvKey"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.AS.BodySecondary"
        tools:text="Daily cap" />

    <TextView
        android:id="@+id/kvMiddle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:visibility="gone"
        tools:text="30s" />

    <TextView
        android:id="@+id/kvValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.AS.Value"
        android:textSize="14sp"
        tools:text="5 overrides" />
</LinearLayout>
