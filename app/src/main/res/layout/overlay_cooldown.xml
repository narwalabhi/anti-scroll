<?xml version="1.0" encoding="utf-8"?>
<!-- A block with no override now: a cooldown counting down, or the day's cap reached. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="28dp">

    <include layout="@layout/overlay_brand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_round_icon"
            android:importantForAccessibility="no"
            android:padding="24dp"
            android:src="@drawable/ic_nav_today" />

        <TextView
            android:id="@+id/cooldownHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AS.OverlayTitle"
            tools:text="Time's up" />

        <TextView
            android:id="@+id/cooldownSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textAppearance="@style/TextAppearance.AS.Lead"
            tools:text="Your session has ended. Overrides are paused for a short cooldown." />

        <TextView
            android:id="@+id/cooldownTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textAppearance="@style/TextAppearance.AS.Timer"
            tools:text="19:42" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/cooldownBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            app:indicatorColor="@color/ink"
            app:trackColor="@color/surface2"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/cooldownNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.AS.Caption3"
            android:textSize="13sp"
            tools:text="Next override opens at 10:12 PM" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.abhishek.antiscroll.ui.widget.DotsView
                android:id="@+id/cooldownDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/cooldownDotsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.AS.BodySecondary"
                tools:text="3 overrides left today" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cooldownPrimary"
        style="@style/AS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close_instagram" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cooldownContinue"
        style="@style/AS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="60dp"
        android:visibility="gone" />
</LinearLayout>
