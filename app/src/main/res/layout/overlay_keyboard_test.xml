<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: checks the keyboard works in an accessibility overlay (milestone 3's typing challenge needs it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/keyboard_test_title"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <EditText
        android:id="@+id/keyboardTestField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/keyboard_test_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/keyboardTestClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/keyboard_test_close" />
</LinearLayout>
