<?xml version="1.0" encoding="utf-8"?>
<!-- After the pause: a purpose and a length (kept from milestone 2, docs/UI.md decision 2026-10-30). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="28dp">

    <include layout="@layout/overlay_brand" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/intention_title"
                android:textAppearance="@style/TextAppearance.AS.OverlayTitle" />

            <TextView
                android:id="@+id/intentionLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.AS.Lead"
                tools:text="58m so far today, 32 min left." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/intention_purpose"
                android:textAppearance="@style/TextAppearance.AS.SectionHeader" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/purposeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/intention_minutes"
                android:textAppearance="@style/TextAppearance.AS.SectionHeader" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/minuteChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/intentionClose"
        style="@style/AS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close_instagram" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/intentionOpen"
        style="@style/AS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:enabled="false"
        android:text="@string/intention_open" />
</LinearLayout>
