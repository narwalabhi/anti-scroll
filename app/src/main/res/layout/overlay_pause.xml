<?xml version="1.0" encoding="utf-8"?>
<!-- The pause on open (ring countdown) and the block screens that still offer an override (icon).
     Closing Instagram is the big button; continuing is smaller (docs/UI.md, principle 5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="28dp">

    <include layout="@layout/overlay_brand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pauseRingBox"
            android:layout_width="168dp"
            android:layout_height="168dp">

            <com.abhishek.antiscroll.ui.widget.RingView
                android:id="@+id/pauseRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/pauseCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/sora_extrabold"
                android:textColor="@color/ink"
                android:textSize="64sp"
                tools:text="2" />
        </FrameLayout>

        <ImageView
            android:id="@+id/pauseIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_round_icon"
            android:importantForAccessibility="no"
            android:padding="24dp"
            android:src="@drawable/ic_nav_today"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pauseHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AS.OverlayTitle"
            tools:text="Open #41 today" />

        <TextView
            android:id="@+id/pauseSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textAppearance="@style/TextAppearance.AS.Lead"
            tools:text="58m so far, 32 min left today." />

        <TextView
            android:id="@+id/pausePill"
            style="@style/AS.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_coral"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="@color/coral"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Over your daily limit"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pausePrimary"
        style="@style/AS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close_instagram" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pauseSecondary"
        style="@style/AS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="60dp"
        tools:text="Open Instagram · 2s" />
</LinearLayout>
